{
  "$description": "근로복지넷 확장 토큰 — KRDS v1.0.0 primitive(color/light/*)를 참조합니다. Tokens Studio 또는 Variables 가져오기 플러그인에서 'KRDS primitive' 세트와 함께 불러오세요.",
  "brand": {
    "green": { "$type": "color", "$value": "{color.light.success.60}", "$description": "로고·브랜드 강조 (#267337)" },
    "blue":  { "$type": "color", "$value": "{color.light.primary.60}", "$description": "로고·검색창 테두리 (#0b50d0)" }
  },
  "button": {
    "brand-fill":       { "$type": "color", "$value": "{color.light.secondary.70}", "$description": "주요 CTA. KRDS primary-fill(primary/50) 대신 기관 네이비 (#063a74)" },
    "brand-fill-hover": { "$type": "color", "$value": "{color.light.secondary.80}", "$description": "주요 CTA hover (#052b57)" }
  },
  "status": {
    "action":   { "text": { "$type": "color", "$value": "{color.light.warning.60}" }, "surface": { "$type": "color", "$value": "{color.light.warning.5}" }, "border": { "$type": "color", "$value": "{color.light.warning.20}" }, "$description": "조치 필요(서류보완) · 아이콘 alert" },
    "progress": { "text": { "$type": "color", "$value": "{color.light.primary.60}" }, "surface": { "$type": "color", "$value": "{color.light.primary.5}" }, "border": { "$type": "color", "$value": "{color.light.primary.20}" }, "$description": "진행 중(서류검토·심사) · 아이콘 clock" },
    "done":     { "text": { "$type": "color", "$value": "{color.light.success.60}" }, "surface": { "$type": "color", "$value": "{color.light.success.5}" }, "border": { "$type": "color", "$value": "{color.light.success.20}" }, "$description": "처리 완료 · 아이콘 check" }
  }
}
